// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
{
  "extends": "./node_modules/@docusaurus/tsconfig/tsconfig.json",
  "compilerOptions": {
    "baseUrl": null,
    "paths": { "@site/*": ["./*"] },
    "types": ["node", "react", "@docusaurus/module-type-aliases", "@docusaurus/theme-classic", "@docusaurus/theme-mermaid"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "exclude": [".docusaurus", "build", "site-tmp", "docs/**"]
}
